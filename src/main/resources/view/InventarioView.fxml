<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tag.sysTagRep.controller.InventarioController"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-padding: 10;">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="header" style="-fx-padding: 5 0 10 0;">
            <Label text="Gestión de Inventario" styleClass="titulo">
                <graphic><FontIcon iconLiteral="fas-boxes" styleClass="titulo-icono"/></graphic>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtBuscar" promptText="Buscar:" prefWidth="250"/>
            <FontIcon iconLiteral="fas-search" iconSize="14"/>
            <TextField fx:id="txtBuscarFactura" promptText="Por Factura:" prefWidth="140"/>
            <Button fx:id="btnNuevo" text="Ingreso por Factura" styleClass="btn-guardar" onAction="#nuevoRegistro">
                <graphic><FontIcon iconLiteral="fas-plus" iconSize="16"/></graphic>
            </Button>
            <Button text="Ingreso por Producto" styleClass="btn-guardar" onAction="#nuevoIngresoPorProducto" style="-fx-background-color: #2563eb;">
                <graphic><FontIcon iconLiteral="fas-box" iconSize="16"/></graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 5;">
            <TableView fx:id="tblInventario" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="150"/>
                    <TableColumn fx:id="colGrupo" text="Grupo" prefWidth="120"/>
                    <TableColumn fx:id="colMarca" text="Marca" prefWidth="150"/>
                    <TableColumn fx:id="colCostoSinIva" text="Costo sin IVA" prefWidth="90"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="70"/>
                    <TableColumn fx:id="colUbicacionPercha" text="Ubicación" prefWidth="110"/>
                    <TableColumn fx:id="colPrecioVenta" text="Precio Venta" prefWidth="90"/>
                    <TableColumn fx:id="colNumeroFactura" text="Nº Factura" prefWidth="90"/>
                    <TableColumn fx:id="colCodigo" text="TagCódigo" prefWidth="90"/>
                    <TableColumn fx:id="colCodigoManual" text="Código" prefWidth="90"/>
                    <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="110"/>
                    <TableColumn fx:id="colFechaIngreso" text="Fecha Ingreso" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="80"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="120"/>
                </columns>
            </TableView>
            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
                <Label text="Registros por pág.:"/>
                <ComboBox fx:id="cmbPageSize" prefWidth="80"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAnterior" text="◀ Anterior" onAction="#irPaginaAnterior"/>
                <Label fx:id="lblPaginaInfo" text="Página 1 de 1 (0 registros)" style="-fx-font-weight: bold;"/>
                <Button fx:id="btnSiguiente" text="Siguiente ▶" onAction="#irPaginaSiguiente"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
