<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<ScrollPane fitToWidth="true" fitToHeight="true"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tag.sysTagRep.controller.Dashboard2Controller">
    <VBox spacing="15" style="-fx-padding: 20;">

        <!-- HEADER CON FLECHA HACIA DASHBOARD 1 -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Button onAction="#irDashboard1" styleClass="btn-orden" style="-fx-min-width: 40; -fx-min-height: 36;">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left" iconSize="18" iconColor="#2c3e50"/>
                </graphic>
            </Button>
            <HBox alignment="CENTER" spacing="15">
                <ImageView fitWidth="80" preserveRatio="true">
                    <image>
                        <Image url="@/img/logoTag.jpeg"/>
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="lblTitulo" text="SYSTAG Repuestos Automotrices" style="-fx-font-family: 'Monospaced'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a252f;"/>
                    <Label text="Dashboard 2 — Análisis de gráficos" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </HBox>
        </HBox>

        <Separator/>

        <!-- FILA 1: GRÁFICOS DE BARRAS LADO A LADO -->
        <HBox spacing="15" VBox.vgrow="ALWAYS">
            <!-- VENTAS -->
            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="panel-claro" style="-fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-padding: 10; -fx-background-radius: 8;">
                <Label text="VENTAS POR DÍA (Últimos 30 días)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <BarChart fx:id="chartVentas" animated="true" prefHeight="260" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Fecha"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Valor ($)" autoRanging="true"/>
                    </yAxis>
                </BarChart>
            </VBox>

            <!-- COMPRAS -->
            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="panel-claro" style="-fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-padding: 10; -fx-background-radius: 8;">
                <Label text="COMPRAS POR DÍA (Últimos 30 días)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <BarChart fx:id="chartCompras" animated="true" prefHeight="260" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Fecha"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Valor ($)" autoRanging="true"/>
                    </yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <!-- FILA 2: GRÁFICOS DE PASTEL LADO A LADO -->
        <HBox spacing="15" VBox.vgrow="ALWAYS">
            <!-- INVENTARIO POR MARCAS -->
            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="panel-claro" style="-fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-padding: 10; -fx-background-radius: 8;">
                <PieChart fx:id="chartMarcas" animated="true" prefHeight="280" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- INVENTARIO POR GRUPOS -->
            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="panel-claro" style="-fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-padding: 10; -fx-background-radius: 8;">
                <PieChart fx:id="chartGrupos" animated="true" prefHeight="280" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>

        <Separator/>

        <!-- FILA 3: NOTIFICACIONES -->
        <VBox spacing="8">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Notificaciones" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Ver todas las alertas" onAction="#irAlertas" styleClass="btn-guardar"/>
            </HBox>
            <TableView fx:id="tblAlertasHome" VBox.vgrow="ALWAYS" prefHeight="160">
                <columns>
                    <TableColumn fx:id="colHomeTipo" text="Tipo" prefWidth="140"/>
                    <TableColumn fx:id="colHomeMensaje" text="Mensaje" prefWidth="500"/>
                    <TableColumn fx:id="colHomeEstado" text="Estado" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
