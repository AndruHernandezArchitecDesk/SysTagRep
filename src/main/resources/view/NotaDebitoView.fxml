<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vendex.controller.NotaDebitoController">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
    <Label text="NOTA DE DÉBITO ELECTRÓNICA SRI TIPO 05" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #006400;"/>
    <HBox spacing="10">
        <VBox spacing="5" prefWidth="400">
            <Label text="Factura base:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbFactura" />
            <Label text="Cliente:"/>
            <Label fx:id="lblCliente"/>
            <Label text="Factura:"/>
            <Label fx:id="lblNumFactura"/>
            <Label text="Fecha:"/>
            <Label fx:id="lblFechaFactura"/>
            <Label text="Total factura:"/>
            <Label fx:id="lblTotalFactura"/>
            <Label text="Forma de pago:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbFormaPago" />
        </VBox>
        <VBox spacing="5">
            <TableView fx:id="tblMotivos" prefHeight="250" prefWidth="500">
                <columns>
                    <TableColumn fx:id="colRazon" text="Razón" prefWidth="350"/>
                    <TableColumn fx:id="colValor" text="Valor" prefWidth="150"/>
                </columns>
            </TableView>
            <HBox spacing="5">
                <TextField fx:id="txtRazon" promptText="Razón del cargo"/>
                <TextField fx:id="txtValor" promptText="Valor"/>
                <Button text="Agregar" onAction="#agregarMotivo"/>
            </HBox>
        </VBox>
    </HBox>
    <HBox spacing="10">
        <Label text="Subtotal sin IVA:"/>
        <Label fx:id="lblSubtotal"/>
        <Label text="IVA (15%):"/>
        <Label fx:id="lblIva"/>
        <Label text="Total a pagar:"/>
        <Label fx:id="lblTotal"/>
    </HBox>
    <HBox spacing="10">
        <TextArea fx:id="txtMotivo" promptText="Motivo adicional (opcional)" prefHeight="50" prefWidth="600"/>
        <ComboBox fx:id="cmbAmbiente" prefWidth="150"/>
        <Label fx:id="lblSecuencial"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Emitir Nota de Débito" onAction="#emitirNotaDebito" style="-fx-background-color: #006400; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"/>
    </HBox>
</VBox>
