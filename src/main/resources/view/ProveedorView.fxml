<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Label?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tag.sysTagRep.controller.ProveedorController"
            prefHeight="600.0" prefWidth="800.0">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="header">
            <Label text="Gestión de Proveedores" styleClass="titulo"/>

            <Button fx:id="btnToggleForm"
                    onAction="#toggleFormulario"
                    styleClass="btn-icono">
                <graphic>
                    <FontIcon iconLiteral="fas-chevron-left" iconSize="16"/>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <SplitPane fx:id="splitPane" dividerPositions="0.35">

            <!-- FORMULARIO -->
            <ScrollPane fx:id="formPane" fitToWidth="true">
                <VBox spacing="15" styleClass="formulario">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <StackPane prefWidth="20">
                            <FontIcon iconLiteral="fas-hashtag" iconSize="14"/>
                        </StackPane>
                        <Label text="ID" prefWidth="100"/>
                        <TextField fx:id="txtId" disable="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <StackPane prefWidth="20">
                            <FontIcon iconLiteral="fas-user" iconSize="14"/>
                        </StackPane>
                        <Label text="Nombre Completo" prefWidth="100"/>
                        <TextField fx:id="txtNombre" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <StackPane prefWidth="20">
                            <FontIcon iconLiteral="fas-id-card" iconSize="14"/>
                        </StackPane>
                        <Label text="Identificacion" prefWidth="100"/>
                        <TextField fx:id="txtIdentificacion" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <StackPane prefWidth="20">
                            <FontIcon iconLiteral="fas-envelope" iconSize="14"/>
                        </StackPane>
                        <Label text="Dirección" prefWidth="100"/>
                        <TextField fx:id="txtDireccion" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <StackPane prefWidth="20">
                            <FontIcon iconLiteral="fas-envelope" iconSize="14"/>
                        </StackPane>
                        <Label text="Email" prefWidth="100"/>
                        <TextField fx:id="txtCorreo" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <StackPane prefWidth="20">
                            <FontIcon iconLiteral="fas-envelope" iconSize="14"/>
                        </StackPane>
                        <Label text="Teléfono Convencional" prefWidth="100"/>
                        <TextField fx:id="txtTelefono" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <StackPane prefWidth="20">
                            <FontIcon iconLiteral="fas-envelope" iconSize="14"/>
                        </StackPane>
                        <Label text="Celular" prefWidth="100"/>
                        <TextField fx:id="txtCelular" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="30" alignment="CENTER_LEFT">
                        <StackPane prefWidth="24">
                            <FontIcon iconLiteral="fas-power-off" iconSize="14"/>
                        </StackPane>
                        <Label text="Estado del Vendedor"/>
                        <ComboBox fx:id="cmbEstado"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="btnGuardar"
                                text=" GUARDAR"
                                styleClass="btn-guardar"
                                onAction="#guardar">
                            <graphic>
                                <FontIcon iconLiteral="fas-save" iconSize="18"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </ScrollPane>

            <!-- Cuadro de busqueda -->
            <VBox spacing="20">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscar"
                               promptText="Buscar:"/>
                    <FontIcon iconLiteral="fas-search" iconSize="14"/>
                </HBox>

                <!-- TABLA -->
                <TableView fx:id="tblProveedores">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                        <TableColumn fx:id="colIdentificacion" text="Identificación" prefWidth="150"/>
                        <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="150"/>
                        <TableColumn fx:id="colCorreo" text="Correo" prefWidth="180"/>
                        <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="180"/>
                        <TableColumn fx:id="colCelular" text="Celular" prefWidth="180"/>
                        <TableColumn fx:id="colFechaRegistro" text="Fecha Registro" prefWidth="180"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="70"/>
                        <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
