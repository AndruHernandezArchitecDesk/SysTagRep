<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.vendex.controller.MainController"
           prefHeight="400.0" prefWidth="600.0"
           styleClass="root-pane">

    <BorderPane StackPane.alignment="CENTER">

    <!-- MENÚ SUPERIOR + BANNER CERTIFICADO -->
    <top>
        <VBox>
        <HBox spacing="0" alignment="CENTER_LEFT">
            <MenuBar HBox.hgrow="ALWAYS">
                <Menu text="Comprobantes">
                    <Menu text="Ingreso">
                        <MenuItem text="Facturas" onAction="#irIngresoFactura"/>
                        <MenuItem text="Facturas Ingresadas" onAction="#irFacturasIngresadas"/>
                    </Menu>
                    <Menu text="Emisión">
                        <MenuItem text="Proforma" onAction="#irNotaVenta"/>
                        <MenuItem text="Factura" onAction="#irFactura"/>
                         <MenuItem text="Nota de Crédito" onAction="#irNotaCredito"/>
                         <MenuItem text="Nota de Débito" onAction="#irNotaDebito"/>
                         <MenuItem text="Guía de Remisión" onAction="#irGuiaRemision"/>
                         <MenuItem text="Retención" onAction="#irRetencion"/>
                          <MenuItem text="Seguimiento SRI" onAction="#irSeguimientoSri"/>
                        <MenuItem text="Facturas Emitidas" onAction="#irComprobanteVentaReporte"/>
                    </Menu>
                </Menu>
                <Menu text="Inventario">
                    <MenuItem text="Ubicación Percha" onAction="#irUbicacionPerchero"/>
                    <MenuItem text="Gestión de Inventario" onAction="#irInventario"/>
                    <MenuItem text="Gestion de Stock" onAction="#irGestionStock"/>
                </Menu>
                <Menu text="Crédito">
                    <MenuItem text="Cuentas por Cobrar" onAction="#irPorCobrar"/>
                    <MenuItem text="Cuentas por Pagar" onAction="#irPorPagar"/>
                </Menu>
                <Menu text="Caja">
                    <MenuItem text="Ver Caja" onAction="#irCaja"/>
                </Menu>
                <Menu text="Historial">
                    <MenuItem text="de Productos" onAction="#irHistorialProductos"/>
                    <MenuItem text="de Ventas" onAction="#irHistorialVentas"/>
                    <MenuItem text="de Compras" onAction="#irHistorialCompras"/>
                </Menu>
                <Menu text="Alertas">
                    <MenuItem fx:id="menuAlertas" text="Ver Alertas" onAction="#irAlertas"/>
                </Menu>
                <Menu text="Administración">
                    <Menu text="Gestión de Usuarios">
                        <MenuItem text="Clientes" onAction="#irClientes"/>
                        <MenuItem text="Usuarios" onAction="#irUsuarios"/>
                        <MenuItem text="Roles y Permisos" onAction="#irGestionRoles"/>
                        <MenuItem text="Proveedores" onAction="#irProveedores"/>
                    </Menu>
                    <Menu text="Catálogos">
                        <MenuItem text="Códigos" onAction="#irCodigos"/>
                        <MenuItem text="Grupos" onAction="#irGrupos"/>
                        <MenuItem text="Marcas" onAction="#irMarcas"/>
                    </Menu>
                    <MenuItem text="Numeración de Documentos" onAction="#irNumeracion"/>
                    <MenuItem text="Firma Electrónica" onAction="#irFirma"/>
                    <MenuItem text="Correo Electrónico" onAction="#irConfiguracionEmail"/>
                    <MenuItem text="Respaldos" onAction="#irRespaldos"/>
                    <MenuItem text="SRI Contingencia (email)" onAction="#irConfigurarContingenciaSRI"/>
                    <MenuItem text="Postgres migrador (Flyway)" onAction="#irConfigurarPostgres"/>
                </Menu>
                <Menu text="Ayuda">
                    <MenuItem text="Asistente de Repuestos" onAction="#irAsistenteRepuestos"/>
                    <MenuItem text="Configurar IA (Gemini)" onAction="#irConfigurarIA"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Acerca de" onAction="#acercaDe"/>
                </Menu>
            </MenuBar>
            <MenuBar>
                <Menu text="Cuenta">
                    <MenuItem fx:id="lblUsuarioSesion" text="Bienvenido"/>
                    <MenuItem text="Home" onAction="#irHome"/>
                    <MenuItem text="Cerrar Sesión" onAction="#cerrarSesion"/>
                    <MenuItem fx:id="menuModoTema" text="Modo Dark" onAction="#cambiarTema"/>
                </Menu>
            </MenuBar>
            <Button fx:id="btnToggleTema" onAction="#cambiarTema" styleClass="btn-orden" prefHeight="28" prefWidth="42">
                <graphic>
                    <FontIcon fx:id="iconToggleTema" iconLiteral="fas-moon" iconSize="16"/>
                </graphic>
            </Button>
        </HBox>
            <HBox fx:id="bannerCertificado" visible="false" managed="false" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #fff3cd; -fx-border-color: #ffc107; -fx-border-width: 0 0 1 0; -fx-padding: 8 12;">
                <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="16" style="-fx-icon-color: #856404;"/>
                <Label fx:id="lblBannerCertificado" HBox.hgrow="ALWAYS" wrapText="true" style="-fx-text-fill: #856404; -fx-font-weight: bold;"/>
                <Button text="Ver Certificado" onAction="#irFirma" styleClass="btn-orden" style="-fx-font-size: 11px;"/>
                <Button text="✕" onAction="#cerrarBannerCertificado" style="-fx-background-color: transparent; -fx-font-weight: bold;"/>
            </HBox>
            <HBox fx:id="bannerSri" visible="false" managed="false" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #fff3cd; -fx-border-color: #ffc107; -fx-border-width: 0 0 1 0; -fx-padding: 8 12;">
                <FontIcon iconLiteral="fas-clock" iconSize="16" style="-fx-icon-color: #856404;"/>
                <Label fx:id="lblBannerSri" HBox.hgrow="ALWAYS" wrapText="true" style="-fx-text-fill: #856404; -fx-font-weight: bold;"/>
                <Button text="Ver Seguimiento SRI" onAction="#irSeguimientoSri" styleClass="btn-orden" style="-fx-font-size: 11px;"/>
                <Button text="✕" onAction="#cerrarBannerSri" style="-fx-background-color: transparent; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <StackPane fx:id="contenedor"/>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="8" styleClass="footer-bar">
            <FontIcon iconLiteral="fas-copyright" iconSize="12"/>
            <Label text="© 2026 Desync by AndruDesk — The Toy Maker — Developer Software" style="-fx-font-size: 11px;"/>
        </HBox>
    </bottom>
</BorderPane>

    <!-- Widget flotante chatbot (pickOnBounds=false no bloquea clicks) -->
    <fx:include source="ChatWidget.fxml"/>

</StackPane>
