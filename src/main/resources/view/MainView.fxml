<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tag.sysTagRep.controller.MainController"
            prefHeight="400.0" prefWidth="600.0"
            styleClass="root-pane">

    <!-- MENÚ SUPERIOR -->
    <top>
        <HBox spacing="0" alignment="CENTER_LEFT">
            <MenuBar HBox.hgrow="ALWAYS">
                <Menu text="Comprobantes">
                    <Menu text="Ingreso">
                        <MenuItem text="Facturas" onAction="#irIngresoFactura"/>
                        <MenuItem text="Facturas Ingresadas" onAction="#irFacturasIngresadas"/>
                    </Menu>
                    <Menu text="Emisión">
                        <MenuItem text="Proforma" onAction="#irNotaVenta"/>
                        <MenuItem text="Factura" onAction="#irFactura"/>
                        <MenuItem text="Seguimiento SRI" onAction="#irSeguimientoSri"/>
                        <MenuItem text="Facturas Emitidas" onAction="#irComprobanteVentaReporte"/>
                    </Menu>
                </Menu>
                <Menu text="Inventario">
                    <MenuItem text="Ubicación Percha" onAction="#irUbicacionPerchero"/>
                    <MenuItem text="Gestión de Inventario" onAction="#irInventario"/>
                    <MenuItem text="Gestion de Stock" onAction="#irGestionStock"/>
                </Menu>
                <Menu text="Crédito">
                    <MenuItem text="Cuentas por Cobrar" onAction="#irPorCobrar"/>
                    <MenuItem text="Cuentas por Pagar" onAction="#irPorPagar"/>
                </Menu>
                <Menu text="Caja">
                    <MenuItem text="Ver Caja" onAction="#irCaja"/>
                </Menu>
                <Menu text="Historial">
                    <MenuItem text="de Productos" onAction="#irHistorialProductos"/>
                    <MenuItem text="de Ventas" onAction="#irHistorialVentas"/>
                    <MenuItem text="de Compras" onAction="#irHistorialCompras"/>
                </Menu>
                <Menu text="Alertas">
                    <MenuItem fx:id="menuAlertas" text="Ver Alertas" onAction="#irAlertas"/>
                </Menu>
                <Menu text="Administración">
                    <Menu text="Gestión de Usuarios">
                        <MenuItem text="Clientes" onAction="#irClientes"/>
                        <MenuItem text="Usuarios" onAction="#irUsuarios"/>
                        <MenuItem text="Proveedores" onAction="#irProveedores"/>
                    </Menu>
                    <Menu text="Catálogos">
                        <MenuItem text="Códigos" onAction="#irCodigos"/>
                        <MenuItem text="Grupos" onAction="#irGrupos"/>
                        <MenuItem text="Marcas" onAction="#irMarcas"/>
                    </Menu>
                    <MenuItem text="Numeración de Documentos" onAction="#irNumeracion"/>
                    <MenuItem text="Firma Electrónica" onAction="#irFirma"/>
                </Menu>
                <Menu text="Ayuda">
                    <MenuItem text="Acerca de" onAction="#acercaDe"/>
                </Menu>
            </MenuBar>
            <MenuBar>
                <Menu text="Cuenta">
                    <MenuItem fx:id="lblUsuarioSesion" text="Bienvenido"/>
                    <MenuItem text="Home" onAction="#irHome"/>
                    <MenuItem text="Cerrar Sesión" onAction="#cerrarSesion"/>
                    <MenuItem fx:id="menuModoTema" text="Modo Dark" onAction="#cambiarTema"/>
                </Menu>
            </MenuBar>
        </HBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <StackPane fx:id="contenedor">
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="15" style="-fx-padding: 20;">

                <!-- LOGO Y TÍTULO -->
                <HBox alignment="CENTER" spacing="15">
                    <ImageView fitWidth="80" preserveRatio="true">
                        <image>
                            <Image url="@/img/logoTag.jpeg"/>
                        </image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="lblTitulo" text="SYSTAG Repuestos Automotrices" style="-fx-font-family: 'Monospaced'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a252f;"/>
                        <Label text="Sistema de Gestión Comercial" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- FILA 1: GRÁFICOS DE BARRAS LADO A LADO -->
                <HBox spacing="15" VBox.vgrow="ALWAYS">
                    <!-- VENTAS -->
                    <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="panel-claro" style="-fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-padding: 10; -fx-background-radius: 8;">
                        <Label text="VENTAS POR DÍA (Últimos 30 días)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <BarChart fx:id="chartVentas" animated="true" prefHeight="260" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis label="Fecha"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Valor ($)" autoRanging="true"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <!-- COMPRAS -->
                    <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="panel-claro" style="-fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-padding: 10; -fx-background-radius: 8;">
                        <Label text="COMPRAS POR DÍA (Últimos 30 días)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <BarChart fx:id="chartCompras" animated="true" prefHeight="260" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis label="Fecha"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Valor ($)" autoRanging="true"/>
                            </yAxis>
                        </BarChart>
                    </VBox>
                </HBox>

                <!-- FILA 2: GRÁFICOS DE PASTEL LADO A LADO -->
                <HBox spacing="15" VBox.vgrow="ALWAYS">
                    <!-- INVENTARIO POR MARCAS -->
                    <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="panel-claro" style="-fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-padding: 10; -fx-background-radius: 8;">
                        <PieChart fx:id="chartMarcas" animated="true" prefHeight="280" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <!-- INVENTARIO POR GRUPOS -->
                    <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="panel-claro" style="-fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-padding: 10; -fx-background-radius: 8;">
                        <PieChart fx:id="chartGrupos" animated="true" prefHeight="280" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- FILA 3: NOTIFICACIONES -->
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Notificaciones" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Ver todas las alertas" onAction="#irAlertas" styleClass="btn-guardar"/>
                    </HBox>
                    <TableView fx:id="tblAlertasHome" VBox.vgrow="ALWAYS" prefHeight="160">
                        <columns>
                            <TableColumn fx:id="colHomeTipo" text="Tipo" prefWidth="140"/>
                            <TableColumn fx:id="colHomeMensaje" text="Mensaje" prefWidth="500"/>
                            <TableColumn fx:id="colHomeEstado" text="Estado" prefWidth="90"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(0,0,0,0.05); -fx-padding: 12 10; -fx-opacity: 0.95;">
            <FontIcon iconLiteral="fas-copyright" iconSize="12" style="-fx-text-fill: #4b5563;"/>
            <Label text="© 2026 Desync by AndruDesk — The Toy Maker — Developer Software" style="-fx-font-size: 11px; -fx-text-fill: #4b5563;"/>
        </HBox>
    </bottom>
</BorderPane>
