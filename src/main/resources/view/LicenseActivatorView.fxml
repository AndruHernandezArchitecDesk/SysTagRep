<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tag.sysTagRep.controller.LicenseActivatorController"
      prefWidth="480" prefHeight="320" style="-fx-background-color: #2b2b2b;">

    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

    <Label text="Activación de Licencia" textFill="white" style="-fx-font-weight: bold;">
        <font><Font size="18"/></font>
    </Label>

    <Label text="Código de máquina:" textFill="#cccccc"/>
    <Label fx:id="lblMachineCode" textFill="#00bfff" style="-fx-font-family: monospace; -fx-font-size: 14px;"/>

    <Separator prefWidth="400"/>

    <Label text="Ingrese el código de licencia:" textFill="#cccccc"/>
    <TextField fx:id="txtLicenseKey" promptText="XXXXX-XXXXX-XXXXX-XXXXX"
               style="-fx-font-family: monospace; -fx-font-size: 14px; -fx-alignment: center;"
               maxWidth="350"/>

    <Label fx:id="lblStatus" textFill="red"/>

    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="btnActivate" text="Activar"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 25;"/>
        <Button fx:id="btnExit" text="Salir"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 25;"/>
    </HBox>

</VBox>
