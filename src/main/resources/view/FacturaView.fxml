<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tag.sysTagRep.controller.FacturaController"
            prefHeight="950.0" prefWidth="1100.0">

    <top>
        <HBox styleClass="nota-header" alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 10; -fx-background-color: #f9fafb;">
            <ImageView fx:id="imgLogo" fitHeight="50" preserveRatio="true"/>
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="SysTag Repuestos" fx:id="lblRazonSocial" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Dirección de la Empresa" fx:id="lblDireccion" style="-fx-font-size: 12px;"/>
                <Label fx:id="lblCorreo" text="Correo: info@systag.com" style="-fx-font-size: 11px;"/>
                <Label fx:id="lblTelefono" text="Tel: 0999999999 / Cel: 099999990" style="-fx-font-size: 11px;"/>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="5">
                <Label text="FACTURA ELECTRÓNICA" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1a252f;"/>
                <Label fx:id="lblRuc" text="RUC: 0000000000001" style="-fx-font-size: 12px;"/>
                <Label text="N° 000000" fx:id="lblNumFactura" style="-fx-text-fill: red; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox spacing="15" style="-fx-padding: 15;">

                <!-- SECCIÓN CLIENTE -->
                <TitledPane text="Información del Cliente" collapsible="false" style="-fx-font-weight: bold;">
                    <content>
                        <VBox spacing="10">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-search" iconSize="14"/>
                                <Label text="Buscar:" minWidth="45"/>
                                <TextField fx:id="txtBuscarCliente" promptText="Nombre o cédula..." prefWidth="350" maxWidth="350"/>
                                <Label text="Seleccionar:" minWidth="70"/>
                                <ComboBox fx:id="cmbCliente" prefWidth="350" maxWidth="350"/>
                            </HBox>

                            <GridPane hgap="15" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="80" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS" />
                                    <ColumnConstraints minWidth="80" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS" />
                                    <ColumnConstraints minWidth="80" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS" />
                                </columnConstraints>

                                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="RUC/Cédula:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtIdentificacion" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                                <Label text="Fecha:" GridPane.rowIndex="0" GridPane.columnIndex="4"/>
                                <DatePicker fx:id="dpFechaFactura" GridPane.rowIndex="0" GridPane.columnIndex="5" maxWidth="Infinity"/>

                                <Label text="Dirección:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtDireccion" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Correo:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtCorreo" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                                <Label text="Teléfono:" GridPane.rowIndex="1" GridPane.columnIndex="4"/>
                                <TextField fx:id="txtTelefono" GridPane.rowIndex="1" GridPane.columnIndex="5"/>
                            </GridPane>
                        </VBox>
                    </content>
                </TitledPane>

                <!-- SECCIÓN SELECCIONAR PRODUCTO -->
                <VBox spacing="8" style="-fx-background-color: #f0f2f5; -fx-padding: 10; -fx-border-color: #d1d5db; -fx-border-radius: 5;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="INVENTARIO DISPONIBLE" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <TextField fx:id="txtBuscarProducto" promptText="Filtrar por nombre o código..." HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAgregarProducto" text="AÑADIR A LA FACTURA" onAction="#agregarProducto" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 15;">
                            <graphic><FontIcon iconLiteral="fas-plus" iconColor="WHITE"/></graphic>
                        </Button>
                    </HBox>
                    <TableView fx:id="tblInventarioBusqueda" prefHeight="100" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colInvCodigo" text="Código" minWidth="100" prefWidth="120"/>
                            <TableColumn fx:id="colInvDescripcion" text="Descripción" minWidth="200"/>
                            <TableColumn fx:id="colInvStock" text="Stock" minWidth="80" prefWidth="100"/>
                            <TableColumn fx:id="colInvPrecio" text="Precio Unitario" minWidth="100" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- TABLA DETALLE -->
                <VBox spacing="2">
                    <Label text="DETALLE DE FACTURA" style="-fx-font-weight: bold;"/>
                    <TableView fx:id="tblDetalle" prefHeight="120">
                        <columns>
                            <TableColumn fx:id="colCodigo" text="Código" minWidth="100" prefWidth="120"/>
                            <TableColumn fx:id="colDescripcion" text="Descripción" minWidth="200"/>
                            <TableColumn fx:id="colCantidad" text="Cant." minWidth="70" prefWidth="80"/>
                            <TableColumn fx:id="colPrecioUnitario" text="P. Unit" minWidth="90" prefWidth="110"/>
                            <TableColumn fx:id="colPrecioTotal" text="Total" minWidth="90" prefWidth="110"/>
                            <TableColumn fx:id="colAcciones" text="Eliminar" minWidth="70" prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- TOTALES -->
                <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-padding: 10 0;">
                    <VBox spacing="5">
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="Forma de Pago:" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="cmbFormaPago" prefWidth="200"/>
                            <HBox fx:id="pnlCredito" spacing="10" visible="false" managed="false" alignment="CENTER_RIGHT">
                                <Label text="Meses:" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="cmbMesesPlazo" prefWidth="100" maxWidth="100"/>
                                <Label text="Interés %:" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="cmbInteres" prefWidth="100" maxWidth="100"/>
                            </HBox>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="Subtotal:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblSubtotal" text="0.00" prefWidth="100" alignment="CENTER_RIGHT"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="IVA (15%):" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblIva" text="0.00" prefWidth="100" alignment="CENTER_RIGHT"/>
                        </HBox>
                        <Separator />
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="TOTAL A PAGAR:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblTotal" text="0.00" prefWidth="120" alignment="CENTER_RIGHT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a252f;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="btnGuardar" text="GENERAR FACTURA ELECTRÓNICA" onAction="#guardar" styleClass="btn-guardar" prefWidth="400" style="-fx-font-size: 14px;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
