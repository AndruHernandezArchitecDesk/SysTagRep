<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vendex.controller.EmpresaController" prefHeight="620.0" prefWidth="620.0" style="-fx-padding: 10">
  <top>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="header" style="-fx-padding: 5 0 10 0">
      <Label text="Mi Empresa" styleClass="titulo">
        <graphic><FontIcon iconLiteral="fas-building" styleClass="titulo-icono"/></graphic>
      </Label>
    </HBox>
  </top>
  <center>
    <ScrollPane fitToWidth="true" style="-fx-padding: 0">
      <VBox spacing="12" style="-fx-padding: 10">
        <TitledPane text="Datos de la Empresa" collapsible="false" styleClass="section-card" style="-fx-font-weight: bold; -fx-padding: 8">
          <content>
            <VBox spacing="8" style="-fx-padding: 5">
              <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane prefWidth="20"><FontIcon iconLiteral="fas-id-card" iconSize="14"/></StackPane>
                <Label text="RUC" prefWidth="140"/>
                <TextField fx:id="txtRuc" HBox.hgrow="ALWAYS" prefHeight="36" promptText="13 dígitos"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane prefWidth="20"><FontIcon iconLiteral="fas-building" iconSize="14"/></StackPane>
                <Label text="Nombre" prefWidth="140"/>
                <TextField fx:id="txtRazonSocial" HBox.hgrow="ALWAYS" prefHeight="36" promptText="TAG Repuestos Automotrices"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane prefWidth="20"><FontIcon iconLiteral="fas-heading" iconSize="14"/></StackPane>
                <Label text="Título" prefWidth="140"/>
                <TextField fx:id="txtTitulo" HBox.hgrow="ALWAYS" prefHeight="36"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane prefWidth="20"><FontIcon iconLiteral="fas-phone" iconSize="14"/></StackPane>
                <Label text="Teléfono" prefWidth="140"/>
                <TextField fx:id="txtTelefono" HBox.hgrow="ALWAYS" prefHeight="36"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane prefWidth="20"><FontIcon iconLiteral="fas-envelope" iconSize="14"/></StackPane>
                <Label text="Correo" prefWidth="140"/>
                <TextField fx:id="txtCorreo" styleClass="no-uppercase" HBox.hgrow="ALWAYS" prefHeight="36"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane prefWidth="20"><FontIcon iconLiteral="fas-map-marker-alt" iconSize="14"/></StackPane>
                <Label text="Dirección" prefWidth="140"/>
                <TextField fx:id="txtDireccion" HBox.hgrow="ALWAYS" prefHeight="36"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane prefWidth="20"><FontIcon iconLiteral="fas-store" iconSize="14"/></StackPane>
                <Label text="Sucursal" prefWidth="140"/>
                <TextField fx:id="txtSucursal" HBox.hgrow="ALWAYS" prefHeight="36"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane prefWidth="20"><FontIcon iconLiteral="fas-book" iconSize="14"/></StackPane>
                <Label text="Obligado contabilidad" prefWidth="140"/>
                <ComboBox fx:id="cmbObligado" HBox.hgrow="ALWAYS" prefHeight="36" maxWidth="Infinity"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane prefWidth="20"><FontIcon iconLiteral="fas-percent" iconSize="14"/></StackPane>
                <Label text="Agente retención" prefWidth="140"/>
                <TextField fx:id="txtAgenteRetencion" HBox.hgrow="ALWAYS" prefHeight="36" promptText="Nº resolución o vacío"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane prefWidth="20"><FontIcon iconLiteral="fas-file-alt" iconSize="14"/></StackPane>
                <Label text="Resolución" prefWidth="140"/>
                <TextField fx:id="txtResolucion" HBox.hgrow="ALWAYS" prefHeight="36"/>
              </HBox>
            </VBox>
          </content>
        </TitledPane>
        <TitledPane text="Logo de la Empresa" collapsible="false" styleClass="section-card" style="-fx-font-weight: bold; -fx-padding: 8">
          <content>
            <VBox spacing="8" style="-fx-padding: 5">
              <HBox spacing="12" alignment="CENTER_LEFT">
                <ImageView fx:id="imgLogo" fitWidth="180" fitHeight="90" preserveRatio="true" smooth="true"/>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                  <Button fx:id="btnExaminarLogo" text="Cargar imagen…" onAction="#cambiarLogo" prefHeight="36" maxWidth="Infinity"/>
                  <Label fx:id="lblLogoRuta" text="Sin logo personalizado" wrapText="true" style="-fx-font-size: 11px" maxWidth="Infinity"/>
                </VBox>
              </HBox>
            </VBox>
          </content>
        </TitledPane>
        <Label fx:id="lblStatus" wrapText="true" style="-fx-font-size: 12px" maxWidth="Infinity"/>
      </VBox>
    </ScrollPane>
  </center>
  <bottom>
    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10">
      <Button fx:id="btnGuardar" text="Guardar Cambios" styleClass="btn-guardar"/>
      <Button fx:id="btnCancelar" text="Cancelar" styleClass="btn-cancelar"/>
    </HBox>
  </bottom>
</BorderPane>
