<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vendex.controller.GestionRolesController">
  <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
  <Label text="Gestión de Roles y Permisos" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
  <Label text="Matriz editable rol × permiso. Cambios aplican en el siguiente login. Solo ADMINISTRADOR con USUARIO_GESTIONAR." wrapText="true" style="-fx-text-fill: #666;"/>
  <HBox spacing="10">
    <Label text="Rol:"/>
    <ComboBox fx:id="cmbRol" prefWidth="200"/>
    <Label text="Tope descuento %:"/>
    <TextField fx:id="txtLimiteDescuento" promptText="vacío=sin límite" prefWidth="120"/>
    <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" style="-fx-background-color: #4caf50; -fx-text-fill: white;"/>
  </HBox>
  <Label fx:id="lblInfo" style="-fx-text-fill: #1565c0;"/>
  <TableView fx:id="tblMatriz" VBox.vgrow="ALWAYS">
    <columns>
      <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="140"/>
      <TableColumn fx:id="colCodigo" text="Código" prefWidth="180"/>
      <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="280"/>
      <TableColumn fx:id="colAsignado" text="Asignado" prefWidth="80"/>
    </columns>
  </TableView>
</VBox>
