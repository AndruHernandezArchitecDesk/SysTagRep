<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<fx:root type="javafx.scene.layout.BorderPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         prefHeight="170.0" styleClass="vendexi-panel">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 4 8 4 8">
            <Label text="Vendexi AI" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblEstado" style="-fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiar"/>
            <Button fx:id="btnVerificar" text="Verificar documento" onAction="#verificar"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox fx:id="sugerenciasBox" spacing="6" style="-fx-padding: 4 8 8 8"/>
        </ScrollPane>
    </center>
</fx:root>
