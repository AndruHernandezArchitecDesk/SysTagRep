<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootStack" pickOnBounds="false" style="-fx-background-color: null;"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.vendex.controller.ChatWidgetController" stylesheets="@../css/chat-widget.css">
    <VBox fx:id="chatPanel" styleClass="chat-panel" visible="false" managed="false" spacing="8">
        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <VBox HBox.hgrow="ALWAYS" spacing="2">
                <Label text="Vetxi" styleClass="chat-header-label"/>
                <Label text="Tu asistente de repuestos y negocio" styleClass="capibara-subtitulo"/>
            </VBox>
            <Label fx:id="badgeIA" text="○ Local" styleClass="badge-local"/>
            <Button text="✕" onAction="#onToggleChat" styleClass="btn-cerrar" accessibleText="Cerrar chat"/>
        </HBox>
        <Label fx:id="lblContexto" wrapText="true" styleClass="capibara-contexto"/>
        <HBox spacing="6">
            <ComboBox fx:id="cmbConversaciones" promptText="Conversaciones anteriores"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="0"/>
            <Button fx:id="btnNuevaConversacion" text="Nueva" onAction="#nuevaConversacion" styleClass="capibara-accion">
                <tooltip><Tooltip text="Iniciar otra conversación sin borrar las anteriores"/></tooltip>
            </Button>
        </HBox>
        <Label fx:id="lblHistorial" text="Historial personal" wrapText="true" styleClass="capibara-subtitulo"/>
        <HBox spacing="6">
            <Button fx:id="btnVerificar" text="Verificar documento" onAction="#verificarDocumento" disable="true" styleClass="capibara-accion"/>
            <Button fx:id="btnPendientes" text="Sugerencias (0)" onAction="#mostrarSugerencias" disable="true" styleClass="capibara-accion"/>
        </HBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll" VBox.vgrow="ALWAYS" minHeight="0">
            <VBox fx:id="mensajesBox" styleClass="mensajes-box" spacing="8">
                <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
            </VBox>
        </ScrollPane>
        <HBox spacing="6" visible="false" managed="false">
            <ComboBox fx:id="cmbMarca" promptText="Marca" prefWidth="90"/>
            <ComboBox fx:id="cmbModelo" promptText="Modelo" prefWidth="90"/>
            <ComboBox fx:id="cmbAnio" promptText="Año" prefWidth="65"/>
        </HBox>
        <HBox spacing="6">
            <TextField fx:id="inputField" promptText="Pregúntame por un repuesto…" HBox.hgrow="ALWAYS" onAction="#onEnviar" minWidth="0"/>
            <Button text="Enviar" onAction="#onEnviar" styleClass="btn-enviar"/>
        </HBox>
    </VBox>

    <VBox fx:id="sugerenciaBubble" styleClass="capibara-globo" visible="false" managed="false" spacing="8">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Vetxi tiene una idea" styleClass="capibara-globo-cabecera" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="lblSugerenciaNumero" styleClass="capibara-subtitulo"/>
            <Button text="✕" onAction="#ocultarSugerencias" styleClass="btn-cerrar" accessibleText="Ocultar sugerencias"/>
        </HBox>
        <Label fx:id="lblSugerenciaTitulo" wrapText="true" maxWidth="310" styleClass="capibara-globo-titulo"/>
        <Label fx:id="lblSugerenciaResumen" wrapText="true" maxWidth="310" styleClass="capibara-subtitulo"/>
        <Label fx:id="lblSugerenciaDetalle" wrapText="true" maxWidth="310" maxHeight="160" visible="false" managed="false" styleClass="capibara-detalle"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Button fx:id="btnAgregarSugerencia" text="Agregar 1" onAction="#agregarSugerencia" styleClass="btn-enviar"/>
            <Button text="Descartar" onAction="#descartarSugerencia" styleClass="capibara-accion"/>
            <Button text="Siguiente ›" onAction="#siguienteSugerencia" styleClass="capibara-accion"/>
        </HBox>
        <HBox spacing="8">
            <Button fx:id="btnDetalles" text="Ver detalles" onAction="#detallesSugerencia" styleClass="capibara-enlace"/>
            <Button text="Copiar" onAction="#copiarSugerencia" styleClass="capibara-enlace"/>
            <Button text="Abrir chat" onAction="#onToggleChat" styleClass="capibara-enlace"/>
        </HBox>
    </VBox>

    <StackPane fx:id="mascota" managed="false" pickOnBounds="false" prefWidth="104" prefHeight="108">
        <Button fx:id="bubbleButton" onAction="#onMascota" styleClass="capibara-boton" StackPane.alignment="TOP_CENTER"
                accessibleText="Vetxi, asistente. Arrastra para mover; pulsa para abrir.">
            <tooltip><Tooltip text="Soy Vetxi. Pulsa para conversar, arrastra para mover o haz clic derecho para activar Guía o cambiar mascota."/></tooltip>
        </Button>
        <Label text="Vetxi" styleClass="capibara-nombre" mouseTransparent="true" StackPane.alignment="BOTTOM_CENTER"/>
        <Label fx:id="contadorSugerencias" text="0" visible="false" mouseTransparent="true"
               styleClass="capibara-contador" StackPane.alignment="TOP_RIGHT"/>
    </StackPane>
</StackPane>
