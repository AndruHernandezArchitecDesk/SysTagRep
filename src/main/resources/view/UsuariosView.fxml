<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tag.sysTagRep.controller.UsuarioController"
            prefHeight="600.0" prefWidth="800.0"
            style="-fx-padding: 10;">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="header" style="-fx-padding: 5 0 10 0;">
            <Label text="Gestión de Usuarios" styleClass="titulo"/>
            <Button fx:id="btnToggleForm" onAction="#toggleFormulario" styleClass="btn-icono">
                <graphic><FontIcon iconLiteral="fas-chevron-left" iconSize="16"/></graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <SplitPane fx:id="splitPane" dividerPositions="0.35">

            <ScrollPane fx:id="formPane" fitToWidth="true">
                <VBox spacing="12" style="-fx-padding: 10;">

                    <TitledPane text="Datos Personales" collapsible="false"
                                styleClass="section-card" style="-fx-font-weight: bold; -fx-padding: 8;">
                        <content>
                            <VBox spacing="8" style="-fx-padding: 5;">
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="20"><FontIcon iconLiteral="fas-hashtag" iconSize="14"/></StackPane>
                                    <Label text="ID" prefWidth="100"/>
                                    <TextField fx:id="txtId" disable="true" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="20"><FontIcon iconLiteral="fas-user" iconSize="14"/></StackPane>
                                    <Label text="Nombre" prefWidth="100"/>
                                    <TextField fx:id="txtNombre" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="20"><FontIcon iconLiteral="fas-user" iconSize="14"/></StackPane>
                                    <Label text="Apellido" prefWidth="100"/>
                                    <TextField fx:id="txtApellido" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="20"><FontIcon iconLiteral="fas-envelope" iconSize="14"/></StackPane>
                                    <Label text="Email" prefWidth="100"/>
                                    <TextField fx:id="txtCorreo" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="20"><FontIcon iconLiteral="fas-user" iconSize="14"/></StackPane>
                                    <Label text="Usuario" prefWidth="100"/>
                                    <TextField fx:id="txtUsuario" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="20"><FontIcon iconLiteral="fas-lock" iconSize="14"/></StackPane>
                                    <Label text="Contraseña" prefWidth="100"/>
                                    <PasswordField fx:id="txtPassword" HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>
                        </content>
                    </TitledPane>

                    <TitledPane text="Configuración" collapsible="false"
                                styleClass="section-card" style="-fx-font-weight: bold; -fx-padding: 8;">
                        <content>
                            <VBox spacing="8" style="-fx-padding: 5;">
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="20"><FontIcon iconLiteral="fas-user-tag" iconSize="14"/></StackPane>
                                    <Label text="Rol" prefWidth="100"/>
                                    <ComboBox fx:id="cmbRol" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="20"><FontIcon iconLiteral="fas-power-off" iconSize="14"/></StackPane>
                                    <Label text="Estado" prefWidth="100"/>
                                    <ComboBox fx:id="cmbEstado" HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>
                        </content>
                    </TitledPane>

                    <TitledPane text="Permisos de Vistas" collapsible="false"
                                styleClass="section-card" style="-fx-font-weight: bold; -fx-padding: 8;">
                        <content>
                            <VBox spacing="5" style="-fx-padding: 5;">
                                <Label text="Marque las vistas a las que el usuario tendrá acceso:" style="-fx-font-size: 11px; -fx-text-fill: #6c757d;"/>
                                <TableView fx:id="tblPermisos" prefHeight="300">
                                    <columns>
                                        <TableColumn fx:id="colVista" text="Vista" prefWidth="260"/>
                                        <TableColumn fx:id="colHabilitado" text="Acceso" prefWidth="70"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
                                    <Button fx:id="btnGuardar" text=" GUARDAR" styleClass="btn-guardar" onAction="#guardar">
                                        <graphic><FontIcon iconLiteral="fas-save" iconSize="18"/></graphic>
                                    </Button>
                                </HBox>
                            </VBox>
                        </content>
                    </TitledPane>

                </VBox>
            </ScrollPane>

            <VBox spacing="20" style="-fx-padding: 5;">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscar" promptText="Buscar:"/>
                    <FontIcon iconLiteral="fas-search" iconSize="14"/>
                </HBox>
                <TableView fx:id="tblUsuarios">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                        <TableColumn fx:id="colApellido" text="Apellido" prefWidth="150"/>
                        <TableColumn fx:id="colCorreo" text="Correo" prefWidth="180"/>
                        <TableColumn fx:id="colRol" text="Rol" prefWidth="180"/>
                        <TableColumn fx:id="colFechaCreacion" text="Fecha Creación" prefWidth="180"/>
                        <TableColumn fx:id="colUltimoLogin" text="Ultimo Login" prefWidth="180"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="70"/>
                        <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
