<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tag.sysTagRep.controller.PorCobrarController"
            prefHeight="700.0" prefWidth="1100.0"
            style="-fx-padding: 15;">

    <top>
        <VBox spacing="10">
            <Label text="Cuentas por Cobrar" styleClass="titulo">
                <graphic><FontIcon iconLiteral="fas-money-bill-wave" styleClass="titulo-icono"/></graphic>
            </Label>
            <Separator/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">

            <!-- SECCION 1: Creditos activos -->
            <TitledPane text="Créditos Activos" collapsible="false" styleClass="section-card" style="-fx-font-weight: bold;">
                <VBox spacing="5">
                    <Label text="Verde: Inicio del plazo  |  Amarillo: Más de la mitad  |  Rojo: Plazo vencido" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    <TableView fx:id="tblCreditosActivos" prefHeight="200" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCliente" text="Cliente" minWidth="200"/>
                            <TableColumn fx:id="colFactura" text="N° Factura" minWidth="130"/>
                            <TableColumn fx:id="colProgreso" text="Estado" minWidth="250"/>
                            <TableColumn fx:id="colVerDetalle" text="" minWidth="60" maxWidth="60"/>
                        </columns>
                    </TableView>
                </VBox>
            </TitledPane>

            <!-- SECCION 2: Detalle y adelanto -->
            <TitledPane text="Detalle de Crédito y Adelanto" collapsible="false" styleClass="section-card" style="-fx-font-weight: bold;">
                <VBox spacing="10">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="Filtrar por cliente:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtFiltroCliente" promptText="Nombre o cédula..." prefWidth="300"/>
                        <Button text="FILTRAR" onAction="#filtrarPorCliente" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 15;">
                            <graphic><FontIcon iconLiteral="fas-search" iconColor="WHITE"/></graphic>
                        </Button>
                        <Button text="LIMPIAR" onAction="#limpiarFiltro" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 15;"/>
                    </HBox>

                    <TableView fx:id="tblDetalleCredito" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="colDetCliente" text="Cliente" minWidth="150"/>
                            <TableColumn fx:id="colDetNota" text="N° Proforma" minWidth="110"/>
                            <TableColumn fx:id="colDetFecha" text="Fecha Emisión" minWidth="110"/>
                            <TableColumn fx:id="colDetArticulos" text="Artículos" minWidth="200"/>
                            <TableColumn fx:id="colDetTiempoPago" text="Plazo" minWidth="80"/>
                            <TableColumn fx:id="colDetTotal" text="Total" minWidth="100"/>
                            <TableColumn fx:id="colDetAdelanto" text="Saldo Pagado" minWidth="100"/>
                            <TableColumn fx:id="colDetPendiente" text="Saldo Pendiente" minWidth="110"/>
                            <TableColumn fx:id="colDetAccion" text="Abono" minWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>
            </TitledPane>

        </VBox>
    </center>

</BorderPane>
