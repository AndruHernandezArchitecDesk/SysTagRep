    <effect><DropShadow color="#087BFF" radius="3" spread="0.15"/></effect>
    <Rectangle x="31" y="54" width="31" height="16" arcWidth="3" arcHeight="3" fill="#16233F" stroke="#19D9FF" strokeWidth="0.9"/>
    <Rectangle x="34" y="56.5" width="25" height="11" arcWidth="1.5" arcHeight="1.5" fill="#071326" stroke="#668BCB" strokeWidth="0.45"/>
    <SVGPath content="M 37 59 L 52 59 M 37 61.5 L 48 61.5 M 37 64 L 54 64" stroke="#19D9FF" strokeWidth="0.7" opacity="0.9"/>
    <Group fx:id="teclas">
      <SVGPath content="M 28 70 L 65 70 L 71 74 Q 50 76 23 74 Z" fill="$shell" stroke="#087BFF" strokeWidth="0.7"/>
      <SVGPath content="M 32 71.5 L 62 71.5 M 35 73 L 59 73 M 40 74 L 54 74" stroke="#16233F" strokeWidth="0.65" strokeLineCap="ROUND"/>
    </Group>
  </Group>
</Group>
